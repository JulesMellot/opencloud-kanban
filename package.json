{
  "name": "web-app-kanban",
  "version": "0.1.0",
  "private": true,
  "description": "Kanban boards and publishing calendar as a native OpenCloud file type (.kanban)",
  "license": "AGPL-3.0",
  "author": "Jules Mellot",
  "homepage": "https://github.com/JulesMellot/opencloud-kanban",
  "repository": {
    "type": "git",
    "url": "https://github.com/JulesMellot/opencloud-kanban"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:w": "vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,vue}' 'tests/**/*.ts' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest --watch=false",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm check:types && pnpm test:unit && pnpm build"
  },
  "devDependencies": {
    "@opencloud-eu/design-system": "^8.2.1",
    "@opencloud-eu/eslint-config": "^8.2.1",
    "@opencloud-eu/extension-sdk": "^8.2.1",
    "@opencloud-eu/prettier-config": "^8.2.1",
    "@opencloud-eu/tsconfig": "^8.2.1",
    "@opencloud-eu/web-client": "^8.2.1",
    "@opencloud-eu/web-pkg": "^8.2.1",
    "@opencloud-eu/web-test-helpers": "^8.2.1",
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.13.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.1.0",
    "happy-dom": "^20.0.0",
    "luxon": "^3.7.2",
    "pinia": "^4.0.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.0.0",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.6",
    "vue3-gettext": "4.0.1"
  },
  "packageManager": "pnpm@11.28.5"
}
